{
   "author": "Trellix LLC",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content.js" ],
      "matches": [ "*://*/*" ],
      "run_at": "document_end"
   } ],
   "description": "Trellix DLP Extension monitors address bar URL and helps to protect corporate data uploads",
   "host_permissions": [ "*://*/*", "\u003Call_urls>" ],
   "icons": {
      "128": "Trellix128.png",
      "16": "Trellix16.png",
      "32": "Trellix32.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Trellix DLP Endpoint Extension",
   "permissions": [ "tabs", "webRequest", "scripting", "webNavigation", "webRequestBlocking", "storage", "nativeMessaging" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.22"
}
